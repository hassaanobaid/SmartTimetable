        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class User {\n    -String userId\n    -String name\n    -String email\n    -String passwordHash\n    -String role\n    +login() void\n    +logout() void\n  }\n\n  class Admin {\n    +manageUsers() void\n    +generateTimetable() Timetable\n    +exportTimetable() void\n  }\n\n  class Teacher {\n    -int maxWorkload\n    -String department\n    +setAvailability() void\n    +viewSchedule() void\n  }\n\n  class Student {\n    -String rollNo\n    -String sectionId\n    +viewSchedule() void\n  }\n\n  class Department {\n    -String deptId\n    -String name\n  }\n\n  class Course {\n    -String courseId\n    -String courseCode\n    -String title\n    -int creditHours\n  }\n\n  class Section {\n    -String sectionId\n    -String sectionName\n    -int studentCount\n  }\n\n  class Room {\n    -String roomId\n    -String roomNumber\n    -int capacity\n    -boolean isLab\n  }\n\n  class TimeSlot {\n    -String slotId\n    -String dayOfWeek\n    -String startTime\n    -String endTime\n  }\n\n  class TimetableGenerator {\n    -String generationStatus\n    -int hardRuleViolations\n    -float softRuleScore\n    +runAlgorithm() Timetable\n    +detectClashes() void\n    +resolveClashes() void\n  }\n\n  class Timetable {\n    -String timetableId\n    -String semester\n    -int academicYear\n    -Date generatedDate\n    +exportToExcel() File\n    +publish() void\n  }\n\n  class ScheduleEntry {\n    -String entryId\n  }\n\n  class ClashResolver {\n    +resolveClashes() void\n  }\n\n  User &lt;|-- Admin\n  User &lt;|-- Teacher\n  User &lt;|-- Student\n\n  Admin \&quot;1\&quot; --&gt; \&quot;*\&quot; User : manages\n  Teacher \&quot;1\&quot; --&gt; \&quot;*\&quot; TimeSlot : provides availability\n  Teacher \&quot;*\&quot; --&gt; \&quot;1\&quot; Department : belongs to\n  Department \&quot;1\&quot; --&gt; \&quot;*\&quot; Course : offers\n  Section \&quot;*\&quot; --&gt; \&quot;1\&quot; Course : enrolls in\n  Student \&quot;*\&quot; --&gt; \&quot;1\&quot; Section : assigned to\n\n  TimetableGenerator \&quot;1\&quot; --&gt; \&quot;1\&quot; Timetable : produces\n  Timetable \&quot;1\&quot; *-- \&quot;1..*\&quot; ScheduleEntry : contains\n  TimetableGenerator --&gt; ClashResolver : triggers\n\n  ScheduleEntry \&quot;1\&quot; --&gt; \&quot;1\&quot; Teacher : assigned to\n  ScheduleEntry \&quot;1\&quot; --&gt; \&quot;1\&quot; Course : scheduled for\n  ScheduleEntry \&quot;1\&quot; --&gt; \&quot;1\&quot; Section : scheduled for\n  ScheduleEntry \&quot;1\&quot; --&gt; \&quot;1\&quot; Room : uses\n  ScheduleEntry \&quot;1\&quot; --&gt; \&quot;1\&quot; TimeSlot : occurs in\n\n  Admin --&gt; TimetableGenerator : invokes\n  Admin --&gt; Timetable : exports\n  Teacher --&gt; Timetable : views\n  Student --&gt; Timetable : views&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2IsizZrp2pQU3OspispA-42">
